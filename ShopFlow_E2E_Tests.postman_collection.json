    {
      "name": "5. Admin: Create Product",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json",
            "type": "text"
          },
          {
            "key": "Authorization",
            "value": "Bearer {{admin_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Wireless Mechanical Keyboard\",\n  \"description\": \"Gateron Brown switches, RGB backlit, hot-swappable.\",\n  \"price\": 89.99,\n  \"category\": \"Electronics\",\n  \"imageUrl\": \"https://example.com/keyboard.jpg\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/products",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Product created - Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Product fields match\", function () {",
              "    pm.expect(jsonData.id).to.be.a('string');",
              "    pm.expect(jsonData.name).to.eql(\"Wireless Mechanical Keyboard\");",
              "    pm.expect(jsonData.price).to.eql(89.99);",
              "});",
              "pm.collectionVariables.set(\"created_product_id\", jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "6. Public: List Products",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/products?category=Electronics&page=0&size=10&sortBy=price&sortDir=asc",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "products"
          ],
          "query": [
            {
              "key": "category",
              "value": "Electronics"
            },
            {
              "key": "page",
              "value": "0"
            },
            {
              "key": "size",
              "value": "10"
            },
            {
              "key": "sortBy",
              "value": "price"
            },
            {
              "key": "sortDir",
              "value": "asc"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Products listed - Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Pagination content holds items\", function () {",
              "    pm.expect(jsonData.content).to.be.an('array');",
              "    pm.expect(jsonData.content.length).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
    {
      "name": "7. Public: Get Product by ID",
      "request": {
        "method": "GET",
        "header": [],
