            "value": "Bearer {{customer_token}}",
            "type": "text"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{customer_user_id}}\",\n  \"shippingAddress\": \"123 Main St, Seattle, WA 98101\",\n  \"items\": [\n    {\n      \"productId\": \"{{created_product_id}}\",\n      \"quantity\": 1\n    }\n  ]\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/orders/checkout",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "orders",
            "checkout"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Checkout successful - Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "var jsonData = pm.response.json();",
              "pm.test(\"Order created in PENDING_PAYMENT status\", function () {",
              "    pm.expect(jsonData.id).to.be.a('string');",
              "    pm.expect(jsonData.status).to.eql(\"PENDING_PAYMENT\");",
              "    pm.expect(jsonData.items.length).to.eql(1);",
              "});",
              "pm.collectionVariables.set(\"created_order_id\", jsonData.id);"
            ],
            "type": "text/javascript"
          }
        }
      ]
    },
